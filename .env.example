# Firebase Configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# App Settings
VITE_ROOT_PERSON_ID_1=gm-1
VITE_ROOT_PERSON_ID_2=gf-1
VITE_FAMILY_NAME_EN=Sadder Family
VITE_FAMILY_NAME_AR=بيت صدّر

# Google Cloud Translation API
# Required for auto-translating English fields to Arabic in edit mode
# Get your API key from: https://console.cloud.google.com/apis/credentials
# Enable the Cloud Translation API: https://console.cloud.google.com/apis/library/translate.googleapis.com
VITE_GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here
