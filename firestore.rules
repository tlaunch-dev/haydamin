rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // People collection
    match /people/{personId} {
      // Anyone can read (for viewing mode)
      allow read: if true;
      
      // TEMPORARY: Allow writes without auth for development
      // TODO: Re-enable auth requirement in Phase 7 (Authentication)
      allow create, update, delete: if true;
      // allow create, update, delete: if isAuthenticated(); // Restore this later
    }
    
    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
